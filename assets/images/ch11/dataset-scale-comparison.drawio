        <mxCell id="scale_indicator" value="&lt;b&gt;数据规模递增&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e79;fontStyle=1;" vertex="1" parent="1">
