          <mxGeometry x="1090" y="230" width="310" height="20" as="geometry" />
        </mxCell>

        <mxCell id="col3_result" value="&lt;b&gt;ViT 表现显著超越 BiT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=3;shadow=1;fontSize=14;fontColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
