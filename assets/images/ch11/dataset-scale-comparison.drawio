        <mxCell id="col2_result" value="&lt;b&gt;ViT 表现与 BiT 接近&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#ef6c00;strokeWidth=2.5;shadow=1;fontSize=13;fontColor=#ef6c00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="265" width="310" height="55" as="geometry" />
        </mxCell>

        <mxCell id="col2_reason" value="&lt;b&gt;转折点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;CNN 归纳偏置优势开始被数据量稀释&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;ViT 在某些配置下略好, 某些略差&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#666666;align=left;spacing=8;spacingLeft=12;" vertex="1" parent="1">
