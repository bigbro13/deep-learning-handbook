        <mxCell id="col3_title" value="&lt;b&gt;大数据集&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
