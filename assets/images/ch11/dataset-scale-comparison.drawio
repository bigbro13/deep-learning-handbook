        <mxCell id="col2_verdict" value="&lt;b&gt;≈ 旗鼓相当&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #888888;&quot;&gt;ViT 开始展现潜力&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#ef6c00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="450" width="310" height="40" as="geometry" />
