        <mxCell id="col3_dataset" value="&lt;b&gt;JFT-300M&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;约 3 亿张 / 18291 类&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2.5;shadow=1;fontSize=13;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
