                    <mxGeometry x="730" y="130" width="730" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="enc_block" value="&lt;b&gt;Multi-Head Self-Attention&lt;/b&gt; + &lt;b&gt;MLP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;堆叠 L 层 (ViT 用 12/24/32 层)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #3a5f23;&quot;&gt;对输入格式完全不敏感, 只看 token 序列&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;shadow=1;fontSize:12;fontColor=#3a5f23;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
