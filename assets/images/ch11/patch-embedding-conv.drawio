        <mxCell id="subtitle" value="卷积核大小 = 步长 = patch 大小,卷积核个数 = 嵌入维度,一次卷积同时完成三件事" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
