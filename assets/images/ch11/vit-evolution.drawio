<mxfile host="app.diagrams.net" modified="2026-08-10T16:30:00.000Z" agent="drawio" version="22.0.0" type="device">
  <diagram name="vit-evolution" id="vit-evolution">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;ViT 的影响与演进&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="500" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="ViT 打开了「CV/NLP 统一架构」时代, 后续工作围绕「如何让 ViT 摆脱大数据依赖」展开" style="text;html=1;align=center;verticalAlign=middle;fontSize:11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="58" width="800" height="22" as="geometry" />
        </mxCell>

        <mxCell id="vit" value="&lt;b&gt;ViT (2020)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;An Image is Worth 16×16 Words&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffffff;&quot;&gt;Google Brain · Dosovitskiy et al.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc; font-style: italic;&quot;&gt;「证明可行性」&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=3;fontColor=#ffffff;shadow=1;fontSize=13;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="arrow_to_deit" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#d79b00;strokeWidth=2.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vit" target="deit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_to_swin" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#d79b00;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vit" target="swin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_to_mae" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#d79b00;strokeWidth=2.5;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vit" target="mae">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="deit" value="&lt;b&gt;DeiT (2021)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Data-efficient Image Transformers&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Facebook AI · Touvron et al.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #a85f00;&quot;&gt;&lt;b&gt;小数据可训&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #555555;&quot;&gt;强数据增强 + ResNet 蒸馏&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2.5;shadow=1;fontSize:12;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="290" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="swin" value="&lt;b&gt;Swin Transformer (2021)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Hierarchical Vision Transformer&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;微软亚洲研究院 · Liu et al.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #a85f00;&quot;&gt;&lt;b&gt;层级 + 局部注意力&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #555555;&quot;&gt;窗口注意力 + 金字塔结构&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2.5;shadow=1;fontSize:12;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="290" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="mae" value="&lt;b&gt;MAE (2021)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Masked Autoencoders Are Scalable&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;何恺明 et al.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #a85f00;&quot;&gt;&lt;b&gt;自监督预训练&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #555555;&quot;&gt;随机遮住 75% patch 重建&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2.5;shadow=1;fontSize:12;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="290" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="deit_problem" value="&lt;font style=&quot;font-size: 9px; color: #555555; font-style: italic;&quot;&gt;解决: ViT 在小数据上效果差&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize:9;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="swin_problem" value="&lt;font style=&quot;font-size: 9px; color: #555555; font-style: italic;&quot;&gt;解决: 密集预测任务(检测/分割)效率低&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize:9;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="590" y="240" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="mae_problem" value="&lt;font style=&quot;font-size: 9px; color: #555555; font-style: italic;&quot;&gt;解决: ViT 依赖海量标注数据&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize:9;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="1080" y="240" width="320" height="20" as="geometry" />
        </mxCell>

        <mxCell id="cv1" value="&lt;b&gt;图像分类&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #3a5f23;&quot;&gt;ImageNet 等基准上&lt;br&gt;ViT 变体持续刷新 SOTA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize:12;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="470" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cv2" value="&lt;b&gt;检测 / 分割 (密集预测)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #3a5f23;&quot;&gt;COCO · ADE20K · Cityscapes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize:12;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cv3" value="&lt;b&gt;视觉大模型 (通用基座)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #3a5f23;&quot;&gt;CLIP · DINOv2 · SAM 的预训练范式&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=2.5;shadow=1;fontSize:12;fontStyle=1;spacing=3;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="470" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_deit_cv1" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#82b366;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="deit" target="cv1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_swin_cv2" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#82b366;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="swin" target="cv2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mae_cv3" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#2e7d32;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mae" target="cv3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="&lt;b&gt;统一架构的时代:&lt;/b&gt; ViT 之后, CV 不再是 CNN 一家独大 —— Transformer 成为视觉任务的通用架构, 也为后来的多模态大模型 (CLIP / Flamingo / GPT-4V) 铺平了道路" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e79;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="555" width="1340" height="22" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
