<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-08-10T16:30:00.000Z" agent="drawio" version="22.0.0" type="device">
  <diagram name="attention-shape-flow" id="attention-shape-flow">
    <mxGraphModel dx="1422" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;多头自注意力:张量形状流转图&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="15" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="理解的关键是抓住两次「形状重组」——reshape/permute 与 transpose/reshape" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="48" width="600" height="22" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="━━━━ 数据流 &amp;nbsp;&amp;nbsp; ▢ 投影/线性层 &amp;nbsp;&amp;nbsp; ▢ 形状重组 &amp;nbsp;&amp;nbsp; ▢ 注意力核心计算 &amp;nbsp;&amp;nbsp; ▢ 拼接/输出投影" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="78" width="1140" height="20" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="&lt;b&gt;① 输入 x&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;197 个 token 拼接好 Class Token + 位置编码&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;B × 197 × 768&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="500" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="&lt;b&gt;② self.qkv(x)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 10px; color: #9673a6;&quot;&gt;Linear(768 → 2304)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;一次线性投影同时得到 Q、K、V&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;B × 197 × 2304&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="&lt;b&gt;③ reshape&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 10px; color: #9673a6;&quot;&gt;.reshape(B, N, 3, 12, 64)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;拆出 QKV 和 12 个头,每个头 64 维&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;B × 197 × 3 × 12 × 64&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="350" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step3_callout" value="&lt;b&gt;第一次重组&lt;/b&gt;&lt;br&gt;3 = QKV,&lt;br&gt;12 = 注意力头数,&lt;br&gt;64 = 头维度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#666666;align=left;spacing=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="360" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="&lt;b&gt;④ permute(2, 0, 3, 1, 4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;把「3」(QKV 维)提到最前,方便切片&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;3 × B × 12 × 197 × 64&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="480" width="500" height="90" as="geometry" />
        </mxCell>

        <mxCell id="step5" value="&lt;b&gt;⑤ 切片 q, k, v&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 10px; color: #555555;&quot;&gt;qkv[0], qkv[1], qkv[2]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;三个张量各自独立进入注意力计算&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;各 B × 12 × 197 × 64&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step6" value="&lt;b&gt;⑥ q @ k.transpose(-2, -1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Q 和 K 的转置做矩阵乘法,得到注意力分数矩阵&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #d6b656;&quot;&gt;* self.scale (head_dim ** -0.5)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #b85450;&quot;&gt;&lt;b&gt;B × 12 × 197 × 197&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="730" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="step6_callout" value="&lt;b&gt;核心计算&lt;/b&gt;&lt;br&gt;每个 token 对其他 196 个 token 的注意力分数&lt;br&gt;矩阵是对称的 197×197" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#666666;align=left;spacing=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="745" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step7" value="&lt;b&gt;⑦ softmax + Dropout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;沿最后一维归一化,得到注意力权重&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #d79b00;&quot;&gt;&lt;b&gt;B × 12 × 197 × 197&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 10px; color: #888888;&quot;&gt; (每行和为 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="870" width="500" height="90" as="geometry" />
        </mxCell>

        <mxCell id="step8" value="&lt;b&gt;⑧ attn @ v&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;注意力权重对 v 加权求和,得到每个头融合后的表征&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #3a5f23;&quot;&gt;&lt;b&gt;B × 12 × 197 × 64&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="990" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step9" value="&lt;b&gt;⑨ transpose + reshape&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;把 12 个头拼回 768 维,完成多头融合&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;B × 197 × 768&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="1120" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step9_callout" value="&lt;b&gt;第二次重组&lt;/b&gt;&lt;br&gt;transpose(1,2): B×12×197×64 → B×197×12×64&lt;br&gt;reshape: → B×197×768" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#666666;align=left;spacing=6;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1130" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step10" value="&lt;b&gt;⑩ self.proj&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 10px; color: #9673a6;&quot;&gt;Linear(768 → 768) + Dropout&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;最终输出投影,残差前准备&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #1f4e79;&quot;&gt;&lt;b&gt;B × 197 × 768&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2.5;shadow=1;fontSize:12;fontStyle=1;spacing=6;spacingTop=4;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="1250" width="500" height="100" as="geometry" />
        </mxCell>

        <mxCell id="step_note" value="&lt;b&gt;总览:&lt;/b&gt; 进入是 768 维, 中间经历「拆出多头的维度」, 出来又拼回 768 维, 输入输出维度完全一致" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1f4e79;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1390" width="1140" height="22" as="geometry" />
        </mxCell>
        <mxCell id="step_note2" value="&lt;font style=&quot;font-size: 10px; color: #888888; font-style: italic;&quot;&gt;两次 permute/reshape 都不改变数据内容, 只调整维度的顺序 —— 这一点是初学者的最大困惑&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="1418" width="1140" height="22" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#6c8ebf;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#9673a6;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#9673a6;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#6c8ebf;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#b85450;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#d79b00;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step6" target="step7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#82b366;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step7" target="step8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#6c8ebf;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step8" target="step9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#9673a6;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step9" target="step10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
