    <diagram name="v2-discrete-sampling" id="v2-discrete-sampling">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="980" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;v2 离散采样代替正弦编码:位置信息更显式&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="1100" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="v1 用连续正弦函数编码浮点坐标;v2 把连续坐标离散化成网格索引 → 位置信息更「显式」,对小物体分辨力更强" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="58" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_v1" value="&lt;b&gt;v1:连续正弦位置编码(Transformer 标准做法)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontSize=14;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="880" height="720" as="geometry"/>
                </mxCell>
                <mxCell id="c_v2" value="&lt;b&gt;v2:离散采样 — 网格索引 + 查表(关键改进)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#cc7a00;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontSize=14;fontColor=#cc7a00;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="980" y="110" width="880" height="720" as="geometry"/>
                </mxCell>
                <mxCell id="v1_in" value="&lt;b&gt;连续坐标 (x, y)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;浮点数,如 (37.42, 18.65)&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="110" y="180" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="v1_formula" value="&lt;b&gt;正弦公式编码&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;PE(x, 2i) = sin(x / 10000^(2i/d))&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;PE(x, 2i+1) = cos(x / 10000^(2i/d))&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;fontColor=#ffffff;shadow=1;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="100" y="310" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v1_out" value="&lt;b&gt;浮点编码向量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;d 维浮点向量&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ 256 维 sin/cos 混合&lt;/b&gt;&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="110" y="460" width="240" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="v1_pros_cons" value="&lt;b&gt;特点:&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;✓ 连续可微,理论优雅&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;✗ 位置信息「隐式」编码在相位里&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;✗ 浮点编码对小物体分辨力弱&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="110" y="580" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v1_axis" value="&lt;b&gt;位置轴示意(连续)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;─── 0 ─── 10 ─── 20 ─── 30 ─── 40 ─── 50 ──→&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="110" y="710" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="v2_in" value="&lt;b&gt;连续坐标 (x, y)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;浮点数,如 (37.42, 18.65)&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="180" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="v2_quantize" value="&lt;b&gt;离散化:round(x / stride)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;连续坐标 → 整数网格索引&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#ff9800;strokeColor=#cc7a00;strokeWidth=2.5;fontColor=#ffffff;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="310" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v2_idx" value="&lt;b&gt;网格索引 (i, j)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;整数,如 (3, 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1350" y="320" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="v2_embed" value="&lt;b&gt;Embedding 查表&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;可学习的 N × d 矩阵&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;fontColor=#ffffff;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
