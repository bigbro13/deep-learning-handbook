                <mxCell id="v1_v1" value="&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;v1:任意实数都映射到唯一编码 → 但相近坐标编码差异可能极小&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="800" width="380" height="20" as="geometry"/>
                </mxCell>
