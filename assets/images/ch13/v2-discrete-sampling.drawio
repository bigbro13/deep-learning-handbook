                    <mxGeometry x="980" y="610" width="60" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="━━━━━&amp;nbsp; 数据流 &amp;nbsp;|&amp;nbsp; 🟦 起点(连续坐标) &amp;nbsp;|&amp;nbsp; 🟧 关键节点(编码公式) &amp;nbsp;|&amp;nbsp; 🟩 输出(编码向量) &amp;nbsp;|&amp;nbsp; 🟪 可学习参数(Embedding 表)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="855" width="1820" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;v2 的「零成本精度提升」:&lt;/b&gt;不改 Decoder 架构,只把位置编码从「浮点相位」改为「网格索引」,让每个网格位置有独立可学习向量 → 小物体位置差异能被模型更直接学到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#444444;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
