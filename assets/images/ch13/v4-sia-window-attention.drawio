                <mxCell id="n_swin" value="&lt;b&gt;设计灵感:Swin Transformer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Liu et al. 2021, ICCV Best Paper&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;用最小计算代价获得「窗口级全局」&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
