                <mxCell id="grid_note_top" value="&lt;b&gt;黄格标 3 个示例窗口(2x2 示意)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;实际划分:7x7 窗口 x 11x11 个(S3 80x80)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;每窗口 49 token 自注意 — 复杂度 O(L*k^2)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="455" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_self_attn" value="&lt;b&gt;窗口内自注意力&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;每个 7x7 窗口独立算 Self-Attention&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;Q,K,V 都来自同一窗口的 49 token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="450" y="180" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_problem" value="&lt;b&gt;问题:窗口间不交互&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;感受野被限制在 7x7 内&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;信息无法跨窗口流动&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="450" y="310" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_complexity" value="&lt;b&gt;复杂度 O(L*k^2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;L = 6400 (S3 总 token)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;k^2 = 49 (窗口大小)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;约 3.1x10^5 vs 全局 L^2 = 4.1x10^7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
