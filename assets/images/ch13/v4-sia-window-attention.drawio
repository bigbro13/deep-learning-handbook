                <mxCell id="e_attn_ben" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#a85f00;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n_shift_attn" target="n_benefit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
