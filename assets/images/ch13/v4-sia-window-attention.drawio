                <mxCell id="e_ben_swin" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#a85f00;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n_benefit" target="n_swin" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_legend_bot" value="&lt;u&gt;图中色块含义&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(31, 78, 121);&quot;&gt;蓝色:&lt;/font&gt; 普通 token 像素&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(168, 95, 0);&quot;&gt;橙色:&lt;/font&gt; 移位后的新窗口&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(150, 115, 166);&quot;&gt;紫色:&lt;/font&gt; 被排除的边缘像素" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;shadow=1;fontSize=11;align=center;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="700" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n_steps_bot" value="&lt;u&gt;Step ② 流程&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;1. 窗口整体平移 k/2 像素&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;2. 新窗口跨越原窗口边界&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;3. masked self-attention&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;4. 边缘 token 移位到对侧&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1.5;shadow=1;fontSize=11;align=center;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="830" width="240" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="n_summary" value="&lt;u&gt;整体收益&lt;/u&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(58, 95, 35);&quot;&gt;计算量级:&lt;b&gt;O(L*k^2) 约等于局部&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(58, 95, 35);&quot;&gt;感受野:&lt;b&gt;移位后可跨窗口传播&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(58, 95, 35);&quot;&gt;实现「卷积效率 + Transformer 全局」&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;shadow=1;fontSize=11;align=center;spacingLeft=10;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="990" width="260" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;关键洞察:&lt;/b&gt;RT-DETRv4 的 SIA 把 Swin Transformer 的「窗口自注意力 + 移位窗口」从纯视觉 Backbone 搬到检测 Encoder,既保留 Transformer 全局建模能力,又把自注意力复杂度从 O(L^2) 压到 O(L*k^2) — 计算量逼近卷积,性能逼近全局注意力。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=14;spacingRight=10;spacingTop=10;" parent="1" vertex="1">
