                <mxCell id="keypoint" value="&lt;b&gt;核心机制:&lt;/b&gt;每一层的预测框既是「本层输出」,又是「下一层参考点」,形成 cascade 精修链。6 层之后,框已从初始锚点精修到接近真实位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="200" y="580" width="1400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="① ② ③ ④ ⑤ ⑥ = Decoder Layer 1 → 6  &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;  浅粉 = 粗略锚点  &amp;nbsp;|&amp;nbsp;  浅橙 = 改善中  &amp;nbsp;|&amp;nbsp;  浅黄 = 接近收敛  &amp;nbsp;|&amp;nbsp;  浅绿 = 已精修" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#999999;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="660" width="1400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="key_insight" value="&lt;b&gt;精度的关键不在「采样点数」,而在「参考点是否准确」&lt;/b&gt;—— 用前一层预测框作参考点,采样点天然落在物体附近,避免了在大范围背景里浪费采样预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="200" y="710" width="1400" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
