                <mxCell id="q1_normal" value="&lt;b&gt;正常 Query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;从 Encoder Memory 选出的 300 个&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;「可能是物体的位置」&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=11;whiteSpace=wrap;html=1;" parent="1" vertex="1">
