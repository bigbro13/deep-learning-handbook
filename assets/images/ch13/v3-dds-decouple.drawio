                </mxCell>
                <mxCell id="q1_l_dn" value="&lt;b&gt;L_dn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;预测 vs 真实框&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;fillColor=#fce4ec;strokeColor=#ff7043;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="760" y="600" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="q1_total" value="&lt;b&gt;L_total = L_normal + L_dn&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="460" y="800" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="q1_problem" value="&lt;b&gt;问题:梯度互相干扰&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;去噪 Query 是「已知真实位置的样本」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;正常 Query 是「从 Memory 选的候选」&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;两者性质不同,但共享权重 → 互相拉扯&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="890" width="800" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="q3_normal" value="&lt;b&gt;正常 Query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;从 Encoder Memory 选出的 300 个&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=11;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="170" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="q3_dn" value="&lt;b&gt;去噪 Query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;加噪的真实框(K 个)&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#ff7043;strokeColor=#c43e00;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=11;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="600" width="260" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="q3_decoder_a" value="&lt;b&gt;Decoder 路径 A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;6 层,仅处理正常 Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;独立权重 θ_A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
