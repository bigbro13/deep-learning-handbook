                    <mxGeometry x="80" y="600" width="280" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="q1_concat" value="&lt;b&gt;拼接成一个序列&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;[正常 Query | 去噪 Query]&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="380" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="q1_decoder" value="&lt;b&gt;共享 Decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;6 层可变形注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;两种 Query 走完全相同的路径&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
