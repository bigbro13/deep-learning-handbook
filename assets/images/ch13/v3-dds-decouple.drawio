                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;DDS 的核心思想:&lt;/b&gt;不同性质的监督信号不应共享权重 — 正常检测关注「从 Memory 选 Query」,去噪关注「从噪声框拉回真实位置」,任务不同,梯度应该独立。让 v3 真正发挥去噪训练的优势" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1.5;dashed=1;fontSize=12;fontColor=#444444;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1030" width="1820" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="━━━━━&amp;nbsp; 正常 Query 路径 &amp;nbsp;|&amp;nbsp; ━━━━━&amp;nbsp; 去噪 Query 路径(珊瑚) &amp;nbsp;|&amp;nbsp; ━━━━&amp;nbsp; 共享/解耦 Decoder(橙=DDS 关键) &amp;nbsp;|&amp;nbsp; ━━━━&amp;nbsp; 损失决策(黄)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1100" width="1820" height="24" as="geometry"/>
                </mxCell>
