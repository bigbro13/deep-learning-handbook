                    <mxGeometry x="1640" y="170" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="q3_l_b" value="&lt;b&gt;L_B (去噪)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;预测 vs 真实框&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;fillColor=#d5e8d4;strokeColor=#ff9800;strokeWidth=2.5;shadow=1;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="600" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="q3_total" value="&lt;b&gt;L_total = L_A + L_B&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #cc7a00;&quot;&gt;两条梯度路径 &lt;b&gt;完全独立&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="800" width="380" height="80" as="geometry"/>
