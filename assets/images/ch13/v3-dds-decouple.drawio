                    <mxGeometry x="40" y="110" width="900" height="900" as="geometry"/>
                </mxCell>
                <mxCell id="c_v3" value="&lt;b&gt;v3 DDS:解耦的双路径(关键改进)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontSize=14;fontColor=#cc7a00;fontStyle=1;" parent="1" vertex="1">
