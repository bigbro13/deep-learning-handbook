    <diagram name="denoising-aux-loss" id="denoising-aux-loss">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;辅助损失 + 去噪训练:让 RT-DETR 训练更稳更快&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="1100" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="辅助损失(每层算 loss)+ 去噪训练(给 GT 加噪作辅助任务)= RT-DETR 训练收敛只需 72 epoch,远少于原始 DETR 的 500 epoch" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="58" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_dn" value="&lt;b&gt;子图 (a) — DN-DETR 去噪训练&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontSize=14;fontColor=#c43e00;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="1820" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="dn_gt" value="&lt;b&gt;真实标注框 GT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;来自数据集标注&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="220" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dn_noise" value="&lt;b&gt;加噪操作&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;中心点偏移 + 尺寸缩放&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #c43e00;&quot;&gt;noise λ=0.5&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#ff7043;strokeColor=#c43e00;strokeWidth=2.5;fontColor=#ffffff;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="340" y="220" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dn_noisy" value="&lt;b&gt;加噪框作为 Query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;额外 Query 拼接到正常 Query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="610" y="220" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dn_decoder" value="&lt;b&gt;Decoder (共享)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;6 层可变形注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;同时处理正常 + 去噪 Query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="900" y="220" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dn_pred" value="&lt;b&gt;预测框(去噪分支)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;去噪 Query 对应的输出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="220" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dn_loss" value="&lt;b&gt;去噪损失 L_dn&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;L1 + GIoU(预测 vs GT)&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="220" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="dn_target" value="&lt;b&gt;目标:预测 = GT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;「去噪」= 把噪声框拉回真实位置&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1750" y="230" width="100" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="dn_note" value="&lt;font style=&quot;font-size: 11px; color: #555555;&quot;&gt;本质:&lt;/font&gt;&lt;font style=&quot;font-size: 11px; color: #c43e00;&quot;&gt;&lt;b&gt;加噪的真实框作「自监督信号」&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 11px; color: #555555;&quot;&gt; — 网络必须知道「正确答案在哪」,避免匈牙利匹配的二义性,提升训练稳定性&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="350" width="1740" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="dn_key" value="&lt;b&gt;关键点:&lt;/b&gt;去噪 Query &amp;amp; 正常 Query &lt;b&gt;共享 Decoder 权重&lt;/b&gt;,梯度来自两条路径 → 需要解耦(详见 v3-dds 图)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
