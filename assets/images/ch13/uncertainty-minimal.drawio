                    <mxGeometry x="1020" y="645" width="360" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="n_right_visual2" value="&lt;b&gt;Decoder 输入分布:基本稳定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #82b366;&quot;&gt;前向间只微调,主干不变&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;shadow=1;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="520" width="400" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="n_right_concl" value="&lt;b&gt;✓ 训练稳定,收敛更快&lt;/b&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=3;fontColor=#ffffff;shadow=1;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="720" width="400" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n_summary" value="&lt;b&gt;核心洞察:温度缩放 = 平滑分布 + 稳定 Top-K&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #555555;&quot;&gt;cls^(1/T) 中 T=2 时,0.9 → 0.95,0.1 → 0.32 — 边界处的极化被压回中间&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #1f4e79;&quot;&gt;代价:训练时 cls 收敛可能略慢,但 Query Selection 的稳定性收益远大于此&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;dashed=1;shadow=1;fontSize=12;fontColor=#666666;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="840" width="1820" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="━━━━━ 数据流 &amp;nbsp;&amp;nbsp; ① ② ③ ④ 顺序 &amp;nbsp;&amp;nbsp; ● 分数点 &amp;nbsp;&amp;nbsp; ▢ 处理节点" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#888888;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="950" width="1820" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="&lt;b&gt;直觉:让分数不要那么「非黑即白」&lt;/b&gt; — 边界处给一点缓冲,Top-K 的选择就不会被一点噪声完全打乱" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#888888;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="980" width="1820" height="22" as="geometry"/>
