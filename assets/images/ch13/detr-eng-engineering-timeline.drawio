                <mxCell id="t1_year" value="&lt;b&gt;2020&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;strokeWidth=1.5;shadow=1;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="180" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="&lt;b&gt;DETR (Facebook AI)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;集合预测 + 一对一匹配&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Transformer Enc-Dec + 100 Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;痛点:500 epoch 慢,小物体弱&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;spacing=4;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="80" y="225" width="240" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="t2_year" value="&lt;b&gt;2021&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;strokeWidth=1.5;shadow=1;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="180" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="&lt;b&gt;Deformable DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;多尺度 + 可变形注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;每 Query 只看 4 个采样点&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;突破:50 epoch 收敛,小物体提升&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;spacing=4;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="360" y="225" width="240" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="t3_year" value="&lt;b&gt;2022&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;strokeWidth=1.5;shadow=1;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="180" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="&lt;b&gt;DAB-DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;显式 4D 坐标 Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Query 编码 (x, y, w, h)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;突破:Query 起点包含位置信息&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;spacing=4;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="640" y="225" width="240" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="t4_year" value="&lt;b&gt;2022&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e79;strokeColor=#1f4e79;strokeWidth=1.5;shadow=1;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="920" y="180" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t4" value="&lt;b&gt;DN-DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;去噪训练 (Denoising)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;给 GT 框加噪让网络学去噪&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;突破:60 epoch 收敛,精度超 Faster R-CNN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=11;fontStyle=1;spacing=4;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="920" y="225" width="240" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="t5_year" value="&lt;b&gt;2023&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a85f00;strokeColor=#a85f00;strokeWidth=2;shadow=1;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="180" width="240" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t5" value="&lt;b&gt;RT-DETR v1 (Baidu)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Hybrid Encoder + IoU-aware Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;AIFI + CCFM + K=300 稀疏预测&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #a85f00;&quot;&gt;&lt;b&gt;里程碑:T4 108 FPS,53.0 AP,实时 + 端到端&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=4;spacingTop=3;" parent="1" vertex="1">
