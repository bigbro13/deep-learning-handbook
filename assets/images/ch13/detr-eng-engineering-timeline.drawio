                <mxCell id="theme_label" value="&lt;b&gt;工程化主线:每一代只解决一个具体问题&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;shadow=1;fontSize=13;fontColor=#444444;fontStyle=1;spacing=6;spacingTop=4;" parent="1" vertex="1">
