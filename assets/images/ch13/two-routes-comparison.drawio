<mxfile host="65bd71144e">
    <diagram name="two-routes-comparison" id="two-routes-comparison">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;实时目标检测的两条平行发展路线:DETR vs YOLO 5 年演进&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1400" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="DETR 路线 5 年走完「证明可行 → 多尺度 → 实时」,YOLO 路线 5 年走完「实时 → 精度极限」,2023 年两线在实时 + 高精度档位交汇" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="100" y="58" width="1600" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_detr" value="&lt;b&gt;DETR 工程化路线 (2020-2023)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;集合预测 + 一对一匹配,5 年解决 Encoder 慢 / Query 差 / 小物体弱 三个工程问题&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="1720" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;2020 DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;集合预测 + 一对一匹配&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;证明可行,500 epoch 慢&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="160" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;2021 Deformable DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;多尺度 + 可变形注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;50 epoch,4 尺度但更慢&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="430" y="160" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;2022 DAB-DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;显式 4D 坐标 Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;Query 编码位置信息&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="780" y="160" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;2022 DN-DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;去噪训练加速收敛&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;60 epoch 收敛,精度超 Faster R-CNN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="160" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;2023 RT-DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Hybrid Encoder + IoU-aware Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #a85f00;&quot;&gt;&lt;b&gt;T4 108 FPS,53.0 AP,实时 + 端到端&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="160" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c_yolo" value="&lt;b&gt;YOLO 工程化路线 (2018-2024)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;密集预测 + Anchor + NMS,5 年不断优化速度 + 精度,但工程包袱难以摆脱&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="420" width="1720" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="&lt;b&gt;2018 YOLOv3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;one-stage 多尺度 FPN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;实时档位奠基者&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="480" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m2" value="&lt;b&gt;2020 YOLOv4 / v5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;CSPDarknet + Mosaic + PANet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;工业部署标准 (Anchor-based)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="430" y="480" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m3" value="&lt;b&gt;2022 YOLOv7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;E-ELAN + 复合缩放&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;速度精度再创新高&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="780" y="480" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m4" value="&lt;b&gt;2023 YOLOv8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Anchor-free + C2f 模块&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;Ultralytics 主线,工业标配&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="480" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="m5" value="&lt;b&gt;2024-2025 v9 / v10 / v11&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;GELAN / 一对一分配 / SPPF&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;尝试去 NMS,但仍依赖 CNN 调优&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="480" width="290" height="120" as="geometry"/>
