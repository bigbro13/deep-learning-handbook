                <mxCell id="label_converge" value="&lt;b&gt;两线在 2023 年实时 + 高精度档位交汇&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1380" y="380" width="380" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="note1" value="&lt;b&gt;DETR 路线:&lt;/b&gt;3 代解决「慢」(Deformable) → 1 代解决「Query 起点差」(DAB) → 1 代解决「收敛慢」(DN) → 1 代解决「实时」(RT-DETR)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3a5f23;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="290" width="1640" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="&lt;b&gt;YOLO 路线:&lt;/b&gt;v3 → v4/v5 工业化 → v7 极限速度 → v8 简化 Anchor → v9/v10/v11 试探端到端但保留 CNN 调优经验" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1f4e79;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="610" width="1640" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="conclusion" value="&lt;b&gt;结论:&lt;/b&gt;DETR 路线 5 年完成「学术 → 工业」跨越,YOLO 路线 5 年持续优化但开始触碰 NMS + Anchor 的工程天花板 —— 两条路线的工程化议题在 2023 年正式合并到 RT-DETR 手中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;shadow=1;align=center;spacing=8;fontSize=12;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="80" y="720" width="1640" height="60" as="geometry"/>
                </mxCell>
