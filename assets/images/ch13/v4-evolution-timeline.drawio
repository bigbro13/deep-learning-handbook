                <mxCell id="trend_label" value="&lt;font style=&quot;font-size: 11px; color: #888888;&quot;&gt;2 年内通过 4 代迭代,AP 提升 2.3 点,速度保持实时档位(100+ FPS)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="500" y="670" width="900" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;演进规律:&lt;/b&gt;v1/v2/v3 是「训练策略」维度的渐进优化(架构不变),v4 是「架构」维度的重大升级(CFE)。前者零成本(只需调训练),后者结构性创新(架构重设计),但每次都解决一个具体的工程问题。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=14;spacingRight=10;spacingTop=10;" parent="1" vertex="1">
