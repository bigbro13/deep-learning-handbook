                <mxCell id="trend_ap" value="&lt;b&gt;AP 上升趋势:53.0 → 53.5 → 54.0 → 55.3&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#3a5f23;fontStyle=1;" parent="1" vertex="1">
