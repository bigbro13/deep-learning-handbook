                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;关键洞察:&lt;/b&gt;高层特征(S5)序列短(400)且语义丰富,适合 Transformer 全局建模;低层(S3/S4)序列长(6400+1600)细节多,改用卷积式融合。&lt;br&gt;在大数据预训练下,1 层 Encoder 就够 — 不必像原始 DETR 堆 6 层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=14;spacingRight=10;spacingTop=10;" parent="1" vertex="1">
