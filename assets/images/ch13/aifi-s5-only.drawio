                <mxCell id="side_brace" value="&lt;b&gt;序列长度 8400 → 400&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #cc7a00;&quot;&gt;&lt;b&gt;Encoder 自注意力计算量降 2500 倍&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;1.0 × 10¹¹ → 4 × 10⁷ 次乘加&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2.5;dashed=1;align=center;spacing=8;spacingLeft=10;spacingRight=10;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="510" y="585" width="220" height="100" as="geometry"/>
