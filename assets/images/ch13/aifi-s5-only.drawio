                </mxCell>
                <mxCell id="subtitle" value="把 S5 特征图展平成 400 个 token,只过 1 层 Encoder;序列长 8400 → 400,计算量降 2500 倍" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="58" width="640" height="24" as="geometry"/>
