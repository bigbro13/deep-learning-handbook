                    <mxGeometry x="120" y="685" width="32" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="n_enc" value="&lt;b&gt;Transformer Encoder Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;Multi-Head Self-Attention + FFN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;&lt;b&gt;只需 1 层就够(不像 DETR 6 层)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
