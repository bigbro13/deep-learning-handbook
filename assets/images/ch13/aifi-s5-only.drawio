                <mxCell id="n_s5_feat" value="&lt;b&gt;S5 特征图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Backbone stride=32 输出&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1f4e79;&quot;&gt;&lt;b&gt;20 × 20 × 256&lt;/b&gt;&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;whiteSpace=wrap;html=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
