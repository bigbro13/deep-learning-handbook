                    <mxGeometry x="120" y="805" width="32" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="n_reshape" value="&lt;b&gt;Reshape 回空间特征图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;400 tokens → 2D 空间布局&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ 20 × 20 × 256&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
