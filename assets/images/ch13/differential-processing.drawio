<mxfile host="65bd71144e">
    <diagram name="differential-processing" id="differential-processing">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;差异化处理:RT-DETR 高效架构的核心思想&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="1200" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="不同尺度 / 不同 Query / 不同任务 / 不同分辨率,各自用最适合的方式处理 — 比「一刀切」更高效" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="300" y="58" width="1300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_main" value="&lt;b&gt;差异化处理思想(Differential Processing)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #444444;&quot;&gt;为不同子任务「按需分配」最合适的处理方式&lt;br&gt;避免一刀切带来的过度计算或性能不足&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#3a5f23;strokeWidth=3;shadow=1;fontSize=14;fontColor=#3a5f23;fontStyle=1;align=center;verticalAlign=middle;spacing=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="700" y="500" width="500" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c_a" value="&lt;b&gt;(a) Encoder 差异化&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#a85f00;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="120" width="660" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="a_high" value="&lt;b&gt;高层 S5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;序列短 + 语义丰富&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #ffe6cc;&quot;&gt;&lt;b&gt;→ Transformer 自注意力&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="100" y="180" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a_low" value="&lt;b&gt;低层 S3/S4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;序列长 + 细节多&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ 卷积式融合(CCFM)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2.5;shadow=1;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="400" y="180" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a_note" value="&lt;b&gt;动机:&lt;/b&gt;高层大物体需要全局语义 → 用自注意力;低层小物体只需局部细节 → 用卷积更便宜" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="100" y="300" width="540" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="a_badge" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#a85f00;strokeColor=#a85f00;fontColor=#ffffff;fontSize=18;fontStyle=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="120" width="40" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c_b" value="&lt;b&gt;(b) Query 差异化&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="120" width="660" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="b_high" value="&lt;b&gt;高分 Query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;cls × IoU 高分位置&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #ffffff;&quot;&gt;&lt;b&gt;→ Decoder 精修&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9c27b0;strokeColor=#6a1b9a;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="180" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b_low" value="&lt;b&gt;低分 Query&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;cls × IoU 低分位置&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #888888;&quot;&gt;&lt;b&gt;→ 直接丢弃(背景)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#888888;strokeWidth=2;dashed=1;shadow=1;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="180" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b_note" value="&lt;b&gt;动机:&lt;/b&gt;高分 Query 是「高质量锚」,值得精修;低分 Query 强行精修浪费算力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="300" width="540" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="b_badge" value="②" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9c27b0;strokeColor=#9c27b0;fontColor=#ffffff;fontSize=18;fontStyle=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="120" width="40" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c_c" value="&lt;b&gt;(c) 训练差异化(DDS)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe9e7;strokeColor=#c43e00;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="800" width="660" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="c_normal" value="&lt;b&gt;正常检测任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;从 Memory 选 Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #ffffff;&quot;&gt;&lt;b&gt;→ 路径 A 独立梯度&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff7043;strokeColor=#c43e00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="100" y="860" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_denoise" value="&lt;b&gt;去噪训练任务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;真实框加噪做 Query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #ffffff;&quot;&gt;&lt;b&gt;→ 路径 B 独立梯度&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff7043;strokeColor=#c43e00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="400" y="860" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_note" value="&lt;b&gt;动机:&lt;/b&gt;两条任务性质不同,简单相加梯度会互相干扰 → 解耦后各走各的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="100" y="980" width="540" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c_badge" value="③" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c43e00;strokeColor=#c43e00;fontColor=#ffffff;fontSize=18;fontStyle=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="800" width="40" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c_d" value="&lt;b&gt;(d) 推理差异化(DQ)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#3a5f23;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="800" width="660" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="d_high" value="&lt;b&gt;高分辨率输入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;1280×1280 大量小物体&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #ffffff;&quot;&gt;&lt;b&gt;→ 增加 Query 数(K&gt;300)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="860" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d_low" value="&lt;b&gt;低分辨率输入&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;640×640 物体稀疏&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #ffffff;&quot;&gt;&lt;b&gt;→ 减少 Query 数(K&lt;300)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1520" y="860" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d_note" value="&lt;b&gt;动机:&lt;/b&gt;分辨率不同 → 潜在物体数差异大,固定 K=300 浪费或不敷使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="980" width="540" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="d_badge" value="④" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3a5f23;strokeColor=#3a5f23;fontColor=#ffffff;fontSize=18;fontStyle=1;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="800" width="40" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e_a" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#a85f00;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.2;entryY=0;endFill=1;" parent="1" source="c_a" target="c_main" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="390" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_b" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#9c27b0;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.8;entryY=0;endFill=1;" parent="1" source="c_b" target="c_main" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1510" y="460"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_c" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#c43e00;strokeWidth=3;exitX=0.5;exitY=0;entryX=0.2;entryY=1;endFill=1;" parent="1" source="c_c" target="c_main" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="390" y="740"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_d" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#3a5f23;strokeWidth=3;exitX=0.5;exitY=0;entryX=0.8;entryY=1;endFill=1;" parent="1" source="c_d" target="c_main" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1510" y="740"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="a_arrow_label" value="Encoder 维度" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#a85f00;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="440" width="120" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="b_arrow_label" value="Query 维度" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#9c27b0;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="440" width="120" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c_arrow_label" value="训练维度" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#c43e00;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="200" y="720" width="120" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="d_arrow_label" value="推理维度" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#3a5f23;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="720" width="120" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;核心洞察:&lt;/b&gt;RT-DETR 的 4 个关键设计都体现「差异化处理」思想 — Encoder 区分高低层、Query 区分高低分、训练区分两任务、推理区分分辨率。这种「按需分配」的思路,比「一刀切」的全局自注意力或「纯卷积」都更高效,是 DETR 工程化的关键方法论。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=14;spacingRight=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1110" width="1700" height="70" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
