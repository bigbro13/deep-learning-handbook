<mxfile host="65bd71144e">
    <diagram name="encoder-computation-problem" id="encoder-computation-problem">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;原始 DETR Encoder 慢在哪里&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="800" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="多尺度特征让 token 数从 1050 涨到 8400,自注意力 O(L²) 把计算量推高 60 倍,完全无法实时" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="300" y="58" width="1200" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_left" value="&lt;b&gt;单尺度 vs 多尺度 对比&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="900" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="c_right" value="&lt;b&gt;计算量爆炸式增长&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="970" y="110" width="790" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="n_single_title" value="&lt;b&gt;单尺度 (原始 DETR)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;只用 H/32 最低分辨率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;shadow=1;fontColor=#ffffff;fontSize=13;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="140" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_single_feat" value="&lt;b&gt;S5 特征图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;stride = 32&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;≈ 20 × 20 = 400 token&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="220" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_single_compute" value="&lt;b&gt;6 层自注意力计算量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;L = 1050 (含位置),d = 256&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;≈ 6 × 1050² × 256 = 1.6 × 10⁹&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="320" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_multi_title" value="&lt;b&gt;多尺度 (FPN 风格)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;S3 + S4 + S5 全用上&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=13;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="140" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_s3" value="&lt;b&gt;S3 (stride = 8)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;80 × 80 = 6400 token&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="220" width="420" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n_s4" value="&lt;b&gt;S4 (stride = 16)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;40 × 40 = 1600 token&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="285" width="420" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n_s5" value="&lt;b&gt;S5 (stride = 32)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;20 × 20 = 400 token&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="350" width="420" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n_total_token" value="&lt;b&gt;合计 token 数&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;8400 (S3 占 76%)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="420" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_multi_compute" value="&lt;b&gt;6 层自注意力计算量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;L = 8400, d = 256&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #b85450;&quot;&gt;&lt;b&gt;≈ 6 × 8400² × 256 = 1.0 × 10¹¹&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="500" y="500" width="420" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_ratio" value="&lt;b&gt;放大倍数:60×&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;单尺度 1.6 × 10⁹ → 多尺度 1.0 × 10¹¹&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;自注意力 O(L²) 让 8400² ≈ 7 × 10⁷ 乘以 256 维&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="440" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_pain" value="&lt;b&gt;根本原因:自注意力 O(L²)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;token 数从 L 涨到 8L,计算量却涨 64 倍&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;Deformable DETR 用每 query 4 个采样点绕开 O(L²)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;代价:实现复杂、硬件不友好,速度仍偏慢&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="580" width="840" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n_formula" value="&lt;b&gt;自注意力复杂度公式&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px; color: #b85450; font-style: italic;&quot;&gt;FLOPs ≈ 2 × L² × d  (Q·Kᵀ)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;L = token 数 (平方关系),d = 通道维 (线性)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="710" width="840" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r1" value="&lt;b&gt;1.6 × 10⁹&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;单尺度 FLOPs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="180" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="&lt;b&gt;1.0 × 10¹¹&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;多尺度 FLOPs (60×)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="320" width="160" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="r3" value="&lt;b&gt;O(L²) → 平方爆炸&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;6400² ≈ 4.1 × 10⁷ 远大于 400² = 1.6 × 10⁵&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="460" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="r4" value="&lt;b&gt;无法实时&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;30 FPS 以下&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#b85450;strokeColor=#7f1d1d;strokeWidth=3;fontColor=#ffffff;shadow=1;fontSize=16;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="600" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="r1" target="r2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="980" y="220"/>
                            <mxPoint x="980" y="370"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e1_label" value="&lt;b&gt;↑ 60×&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="930" y="280" width="60" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#b85450;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="r2" target="r3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#b85450;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="r3" target="r4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="warn" value="❗" style="text;html=1;align=center;verticalAlign=middle;fontSize=80;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="380" width="120" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="warn2" value="❗" style="text;html=1;align=center;verticalAlign=middle;fontSize=60;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="200" width="100" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="warn_text" value="&lt;b&gt;DETR 多尺度 = 灾难&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #b85450;&quot;&gt;原始 DETR 的 O(L²) 在多尺度下&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #b85450;&quot;&gt;完全无法实时&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;dashed=1;shadow=1;fontSize=14;fontColor=#b85450;fontStyle=1;spacing=4;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="540" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="callout" value="&lt;b&gt;结论:自注意力 + 多尺度 = 不可调和的矛盾&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #555555;&quot;&gt;要么放弃多尺度 (DETR,小物体弱), 要么放弃自注意力 (Deformable DETR,实现复杂)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #1f4e79;&quot;&gt;&lt;b&gt;RT-DETR 的解法:只在 S5 做自注意力,其余层用卷积融合 → 下一节展开&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;shadow=1;fontSize=12;fontColor=#666666;align=left;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="970" y="700" width="780" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
