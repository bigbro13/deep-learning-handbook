                <mxCell id="e_input_s5" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#6c8ebf;strokeWidth=2.5;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" parent="1" source="n_input" target="n_s5_in" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c_v3" value="&lt;b&gt;对比:v1 Hybrid Encoder (AIFI + CCFM)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=11;fontColor=#888888;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="150" width="360" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="v3_aifi" value="&lt;font style=&quot;font-size: 10px; color: #888888;&quot;&gt;• AIFI:仅在 S5 做全局自注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #888888;&quot;&gt;• CCFM:三尺度卷积式全位置融合&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;× 不足:S3 小物体全局建模弱,跨大尺度差异融合受限&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="190" width="340" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="c_v4" value="&lt;b&gt;v4 CFE (本图)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=11;fontColor=#cc7a00;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="350" width="360" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="v4_sia" value="&lt;font style=&quot;font-size: 10px; color: #cc7a00;&quot;&gt;• SIA:三尺度都做窗口自注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #cc7a00;&quot;&gt;• CIF:关键位置采样式跨尺度融合&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;✓ 小物体也获得全局上下文,跨大尺度融合更精细&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="390" width="340" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;CFE 思想:&lt;/b&gt;把「尺度内交互」和「跨尺度融合」彻底解耦,各自用最适合的方式实现 — 内部用窗口自注意力(Swin-style),跨尺度用可变形采样(Deformable-style)。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=left;spacing=8;spacingLeft=14;spacingRight=10;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="970" width="1000" height="70" as="geometry"/>
                </mxCell>
