                <mxCell id="c_cif" value="&lt;b&gt;CIF:Cross-scale Interaction Fusion(跨尺度)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #cc7a00;&quot;&gt;在少量关键位置上做跨尺度采样融合 — 借鉴可变形注意力思路&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="480" y="600" width="660" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="n_sia_in_cif" value="&lt;b&gt;SIA 输出 {S3', S4', S5'}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #cc7a00;&quot;&gt;作为 CIF 的输入&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#fff3e0;strokeColor=#ff9800;strokeWidth=2;shadow=1;fontSize=11;whiteSpace=wrap;html=1;" parent="1" vertex="1">
