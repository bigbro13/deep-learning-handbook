                </mxCell>
                <mxCell id="n_keypoint" value="&lt;b&gt;选关键位置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;每尺度挑 Top-N 个 token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;N 远小于 L&lt;/font&gt;" style="shape=mxgraph.flowchart.decision;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;shadow=1;fontSize=11;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
