                <mxCell id="n_sia_s3" value="&lt;b&gt;S3 窗口自注意力&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;7×7 窗口 × 11×11 个窗口&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;每窗口 49 token 自注意&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
