                <mxCell id="title" value="&lt;b&gt;CFE:解耦的「内部 + 跨尺度」交互 (RT-DETRv4)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="1200" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="把「尺度内交互」交给 SIA(窗口自注意力),「跨尺度融合」交给 CIF(关键位置采样);两者都用高效方式实现" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
