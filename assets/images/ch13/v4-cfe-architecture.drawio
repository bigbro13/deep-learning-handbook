                <mxCell id="n_fused" value="&lt;b&gt;CFE 融合输出 {S3'', S4'', S5''}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffffff;&quot;&gt;已做尺度内 + 跨尺度融合&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=2.5;fontColor=#ffffff;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
