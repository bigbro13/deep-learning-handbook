                <mxCell id="n_cross" value="&lt;b&gt;跨尺度采样 + 加权融合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;每个关键位置在另两尺度采 4 点&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ffe6cc;&quot;&gt;Deformable-style 注意力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=11;fontStyle=1;spacing=3;spacingTop=2;" parent="1" vertex="1">
