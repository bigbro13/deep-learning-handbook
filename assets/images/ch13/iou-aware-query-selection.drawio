                <mxCell id="rtdetr_label" value="&lt;b&gt;新路径(分类 + IoU)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#3a5f23;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1340" y="550" width="200" height="20" as="geometry"/>
