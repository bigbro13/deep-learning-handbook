                <mxCell id="e_iou_mul" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#9c27b0;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" parent="1" source="iou_branch" target="mul" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_mul_vanilla" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#82b366;strokeWidth=2.5;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" parent="1" source="mul" target="vanilla_problem" edge="1">
                    <mxGeometry relative="1" as="geometry">
