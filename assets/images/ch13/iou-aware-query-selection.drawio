                <mxCell id="vanilla_label" value="&lt;b&gt;旧路径(仅分类)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
