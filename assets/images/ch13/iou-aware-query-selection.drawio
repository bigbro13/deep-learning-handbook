<mxfile host="65bd71144e">
    <diagram name="iou-aware-query-selection" id="iou-aware-query-selection">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;IoU-aware Query Selection:同时考虑分类 + 定位质量&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="1100" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="传统做法只看分类分数,会选到「高分但定位差」的 Query;RT-DETR 综合 cls × IoU 选 Top-K,质量更高" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="300" y="58" width="1200" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="memory" value="&lt;b&gt;Encoder Memory 每个位置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;每个 token 含图像局部特征&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="150" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cls_branch" value="&lt;b&gt;分类分支&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;FFN → softmax&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;预测 C+1 类分数&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="100" y="310" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="iou_branch" value="&lt;b&gt;IoU 分支&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;3 层 MLP + sigmoid&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #9c27b0;&quot;&gt;&lt;b&gt;预测框的 IoU 分数&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#9c27b0;strokeWidth=2.5;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="100" y="470" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="mul" value="&lt;b&gt;综合分数 = cls × IoU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;分类可信 ∧ 定位可信&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="380" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="vanilla_box" value="&lt;b&gt;传统做法:只看分类分数&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="150" width="500" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="vanilla_desc" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;只挑「分类自信」的位置,但&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #b85450;&quot;&gt;&lt;b&gt;预测的框可能完全错位&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="220" width="440" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vanilla_problem" value="&lt;b&gt;问题:高分但定位差&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;cls=0.95 但 IoU=0.3&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;Decoder 精修困难&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=11;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="280" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="rtdetr_box" value="&lt;b&gt;RT-DETR:分类 + IoU 综合考虑&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontSize=12;fontColor=#3a5f23;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="500" width="500" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="rtdetr_desc" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;用 cls × IoU 挑「双高」位置 → &lt;/font&gt;&lt;font style=&quot;font-size: 11px; color: #3a5f23;&quot;&gt;&lt;b&gt;Decoder 只需精修,无需纠错&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="570" width="440" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="rtdetr_advantage" value="&lt;b&gt;Query 质量更高&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;cls=0.9 且 IoU=0.85&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;Decoder 收敛更快&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;shadow=1;fontSize=11;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="630" width="320" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="topk" value="&lt;b&gt;按综合分数排序&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Top-K=300&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="740" y="800" width="240" height="100" as="geometry"/>
