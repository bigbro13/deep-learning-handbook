                <mxCell id="e23" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#6c8ebf;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n2" target="n3" edge="1">
