                <mxCell id="legend" value="━━━━ 数据流  &amp;nbsp;&amp;nbsp;  ▰ Backbone/FFN  &amp;nbsp;&amp;nbsp;  ▰▰ 关键工程改进(Encoder / Decoder / Query Selection)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#888888;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="490" width="1500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="keypoint" value="&lt;b&gt;核心赌注:&lt;/b&gt;Encoder 不用全尺度自注意力(序列长从 8400 降到 400)&amp;nbsp; + &amp;nbsp;Query 用 Encoder Memory 挑选而非随机初始化 → 训练从 500 epoch 降到 72 epoch,推理从 30 FPS 到 108 FPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;dashed=1;fontSize=11;fontColor=#444444;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
