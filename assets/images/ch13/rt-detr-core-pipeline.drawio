<mxfile host="65bd71144e">
    <diagram name="rt-detr-core-pipeline" id="rt-detr-core-pipeline">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="620" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;RT-DETR 核心 Pipeline:端到端实时检测&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="900" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="保留 DETR 端到端优势(无 NMS),通过 Efficient Hybrid Encoder + IoU-aware Query Selection 把推理推到实时档位" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="300" y="58" width="1300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="&lt;b&gt;输入图像&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;640 × 640 × 3&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#6c8ebf;strokeColor=#1f4e79;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=13;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="290" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;① Backbone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;HGNetv2 / ResNet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ {S3, S4, S5}&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="270" y="270" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;② Hybrid Encoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;AIFI + CCFM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ 多尺度特征交互&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #a85f00;&quot;&gt;关键:Encoder 自注意力仅作用于 S5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="550" y="250" width="240" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;③ Query Selection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;IoU-aware + Uncertainty-minimal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ 选 Top-K=300 Query&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #9c27b0;&quot;&gt;同时考虑分类+定位质量&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#9c27b0;strokeWidth=2.5;shadow=1;fontSize=11;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="870" y="250" width="260" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;④ Decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;6 层可变形注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;→ 迭代精修 object query&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #a85f00;&quot;&gt;辅助损失 + 去噪训练&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="250" width="240" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;⑤ FFN Head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;每个 Query 一次预测&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;→ 类别 + 框坐标&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1530" y="270" width="220" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="&lt;b&gt;最终检测&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;无 NMS&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#82b366;strokeColor=#3a5f23;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=13;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1810" y="290" width="160" height="80" as="geometry"/>
