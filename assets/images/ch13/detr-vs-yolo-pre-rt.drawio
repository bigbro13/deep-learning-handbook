<mxfile host="65bd71144e">
    <diagram name="detr-vs-yolo-pre-rt" id="detr-vs-yolo-pre-rt">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="920" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;2023 年之前:DETR vs YOLO 的二选一困境&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="20" width="1000" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="DETR 路线 精度高但慢,YOLO 路线 实时但需 NMS + 精度天花板,工业部署只能二选一" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="250" y="58" width="1200" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_detr" value="&lt;b&gt;DETR 路线:精度高但慢&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #666666;&quot;&gt;2020 → 2021 → 2022,三代迭代,精度超 Faster R-CNN 但速度始终跟不上&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="1100" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="n_detr2020" value="&lt;b&gt;2020 原始 DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;集合预测 + 一对一匹配&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;500 epoch 才收敛&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="180" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_detr2021" value="&lt;b&gt;2021 Deformable DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;多尺度 + 可变形注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;50 epoch,但 4 尺度更慢&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="360" y="180" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_detr2022" value="&lt;b&gt;2022 DN-DETR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;去噪训练 + 加速收敛&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;60 epoch 收敛,精度超 Faster R-CNN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="660" y="180" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="t_detr_block" value="&lt;b&gt;无法实时,被 YOLO 压制&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;T4 GPU 仅 30-40 FPS&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#b85450;strokeColor=#b85450;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="960" y="180" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_yolo" value="&lt;b&gt;YOLO 路线:实时但有工程包袱&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #666666;&quot;&gt;2018 → 2020 → 2022/YOLOv5 → v7 → v8,持续优化推理速度,精度提升受阻&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="480" width="1100" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="n_yolo" value="&lt;b&gt;YOLOv5 / v7 / v8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;纯 CNN 密集预测 + Anchor&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #3a5f23;&quot;&gt;&lt;b&gt;T4 GPU 100+ FPS 实时&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="560" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_yolo_nms" value="&lt;b&gt;后处理 NMS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;非极大值抑制&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;阈值需调,时延不稳定&lt;/b&gt;&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="360" y="560" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_yolo_anchor" value="&lt;b&gt;Anchor + 正负样本分配&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;手工设计超参&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;&lt;b&gt;调参成本高,泛化受限&lt;/b&gt;&lt;/font&gt;" style="shape=mxgraph.flowchart.preparation;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="660" y="560" width="240" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="t_yolo_block" value="&lt;b&gt;精度天花板 + 工程包袱&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;AP 难破 + 部署复杂&lt;/font&gt;" style="shape=mxgraph.flowchart.terminator;fillColor=#b85450;strokeColor=#b85450;strokeWidth=2;fontColor=#ffffff;shadow=1;fontSize=12;fontStyle=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="960" y="560" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c_block" value="&lt;b&gt;工业部署受阻&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #b85450;&quot;&gt;二选一:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;DETR 慢 → 用 YOLO 但需妥协 NMS/Anchor 工程包袱&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;YOLO 精度差 → 想用 DETR 但跑不到实时档位&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;shadow=1;fontSize=13;fontStyle=1;spacing=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="320" width="420" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="e_d20_d21" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#3a5f23;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n_detr2020" target="n_detr2021" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_d21_d22" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#3a5f23;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n_detr2021" target="n_detr2022" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_d22_block" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n_detr2022" target="t_detr_block" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_y_yolonms" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#3a5f23;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n_yolo" target="n_yolo_nms" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_y_nms_anchor" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#3a5f23;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n_yolo_nms" target="n_yolo_anchor" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_y_anchor_block" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="n_yolo_anchor" target="t_yolo_block" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_detr_top_to_center" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" parent="1" source="t_detr_block" target="c_block" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1200" y="225"/>
                            <mxPoint x="1200" y="370"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_yolo_bot_to_center" style="endArrow=classic;html=1;rounded=1;curved=1;strokeColor=#b85450;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" parent="1" source="t_yolo_block" target="c_block" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1200" y="605"/>
                            <mxPoint x="1200" y="470"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="note1" value="&lt;b&gt;DETR 路线:&lt;/b&gt;从 500 epoch 降到 60 epoch,但推理速度仍停留在 30-40 FPS,实时检测场景无法落地" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3a5f23;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="290" width="1020" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="note2" value="&lt;b&gt;YOLO 路线:&lt;/b&gt;100+ FPS 实时档位,但 NMS 阈值、Anchor 设计、正负样本分配都是手工调参的工程负担,AP 难以继续突破" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3a5f23;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="670" width="1020" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="note3" value="&lt;b&gt;工业部署的核心矛盾:&lt;/b&gt;实时 + 精度 + 端到端 三者不能同时满足 —— 这正是 RT-DETR 2023 年要打破的" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="350" y="830" width="1000" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="legend_detr" value="━━ DETR 进化链" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#3a5f23;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="135" width="140" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="legend_yolo" value="━━ YOLO 工程链条" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#3a5f23;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="80" y="515" width="140" height="20" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
