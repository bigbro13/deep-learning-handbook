<mxfile host="65bd71144e">
    <diagram name="v4-hybrid-encoder-limits" id="v4-hybrid-encoder-limits">
        <mxGraphModel dx="1666" dy="1139" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b&gt;v1 Hybrid Encoder 的两个局限 → v4 CFE 解耦优化&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="900" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="AIFI 只在 S5 做 → 小物体 (S3) 全局上下文不足; CCFM 卷积式融合 → 跨大尺度差异融合受限" style="text;html=1;align=center;verticalAlign=middle;fontSize:12;fontColor=#666666;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="300" y="58" width="1300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c_p1" value="&lt;b&gt;局限 ① AIFI 只在 S5 做,小物体 (S3) 全局上下文不足&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="40" y="110" width="900" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="c_p2" value="&lt;b&gt;局限 ② CCFM 卷积融合,跨大尺度差异 (S3 ↔ S5) 效果有限&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1.5;dashed=1;verticalAlign=top;spacingTop=8;fontSize=13;fontColor=#444444;" parent="1" vertex="1">
                    <mxGeometry x="960" y="110" width="900" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="❌" style="text;html=1;align=center;verticalAlign=middle;fontSize=48;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="140" width="60" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_title" value="&lt;b&gt;问题:小物体缺少全局上下文&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;AIFI 只在 S5 做自注意力,跳过 S3 和 S4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontSize=13;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="140" y="140" width="780" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_chart" value="&lt;b&gt;多尺度特征图 + AIFI 覆盖范围&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;shadow=1;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="220" width="840" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_s3" value="&lt;b&gt;S3 (小物体)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;80 × 80 = 6400 token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="140" y="260" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_s4" value="&lt;b&gt;S4 (中物体)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;40 × 40 = 1600 token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="360" y="260" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_s5" value="&lt;b&gt;S5 (大物体)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;20 × 20 = 400 token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="580" y="260" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_aifi" value="&lt;b&gt;AIFI 自注意力 ✓&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #d79b00;&quot;&gt;400 token 短序列 OK&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #d79b00;&quot;&gt;全局上下文丰富&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#a85f00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize:12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="580" y="340" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_s3_no" value="&lt;b&gt;S3 跳过 AIFI ❌&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;6400 token 太长&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;全局上下文缺失&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="140" y="340" width="200" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_s4_no" value="&lt;b&gt;S4 跳过 AIFI ❌&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;1600 token 也不做&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="360" y="340" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_visual" value="&lt;b&gt;直觉:远处的行人需要「看全图」才能判断是不是背景里的广告牌&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;但 S3 的 6400 token 序列太短 (相对完整图),没法做全局自注意力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;dashed=1;shadow=1;fontSize:12;align=left;spacing=8;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="100" y="450" width="800" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_sol" value="&lt;b&gt;v4 解法: SIA (Scale-aware Inner Attention)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;用「窗口注意力 + 移位窗口」在每个尺度内做局部自注意力&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;O(L × k²),k=7 → 即使 S3 也吃得消&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;dashed=1;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="80" y="600" width="840" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_arrow_s3" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#b85450;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" parent="1" source="n_p1_s3" target="n_p1_s3_no" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_arrow_s4" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#b85450;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" parent="1" source="n_p1_s4" target="n_p1_s4_no" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_arrow_s5" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#82b366;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n_p1_s5" target="n_p1_aifi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_p1_arrow_sol" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#82b366;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n_p1_visual" target="n_p1_sol" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="❌" style="text;html=1;align=center;verticalAlign=middle;fontSize=48;fontColor=#b85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="980" y="140" width="60" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_title" value="&lt;b&gt;问题:跨大尺度融合效果差&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;CCFM 用卷积式融合, S3 和 S5 差 4 倍分辨率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2.5;shadow=1;fontSize:13;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="140" width="780" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_chart" value="&lt;b&gt;CCFM 卷积式跨尺度融合 (示意)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff9800;strokeWidth=2;dashed=1;shadow=1;fontSize=12;align=center;verticalAlign=middle;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="220" width="840" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_s3" value="&lt;b&gt;S3 特征&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;细节丰富, 高分辨率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="260" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_s4" value="&lt;b&gt;S4 特征&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;中等分辨率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;fontSize:12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="260" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_s5" value="&lt;b&gt;S5 特征&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;语义丰富, 低分辨率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1500" y="260" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_conv" value="&lt;b&gt;CCFM (卷积式)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;上/下采样 + 3×3 卷积 + 加权求和&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #b85450;&quot;&gt;问题: S3 和 S5 直接卷积融合 → 细节丢失 + 语义稀释&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ff9800;strokeColor=#cc7a00;strokeWidth=2.5;shadow=1;fontColor=#ffffff;fontSize:12;fontStyle=1;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="340" width="640" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_arrow_s3" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#ff9800;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" parent="1" source="n_p2_s3" target="n_p2_conv" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_arrow_s4" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#ff9800;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n_p2_s4" target="n_p2_conv" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_arrow_s5" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#ff9800;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" parent="1" source="n_p2_s5" target="n_p2_conv" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_visual" value="&lt;b&gt;问题示意:4 倍分辨率差异,直接卷积融合损失信息&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;S3 (80×80) → 下采样 4× → 20×20,细节大量丢失&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;S5 (20×20) → 上采样 4× → 80×80,语义被「稀释」到低密度像素上&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;dashed=1;shadow=1;fontSize:12;align=left;spacing=8;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="450" width="800" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_sol" value="&lt;b&gt;v4 解法: CIF (Cross-scale Interaction Fusion)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;借鉴 Deformable 思路,只在「关键位置」做跨尺度注意力 (稀疏融合)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1f4e79;&quot;&gt;&lt;b&gt;自适应选择采样点,避免 CCFM 全位置卷积的开销和损失&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;dashed=1;shadow=1;fontSize=12;spacing=4;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="600" width="840" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n_p2_arrow_sol" style="endArrow=classic;html=1;rounded=1;curved=0;strokeColor=#82b366;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="n_p2_visual" target="n_p2_sol" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_summary" value="&lt;b&gt;v1 → v4 关键升级:从「AIFI + CCFM 解耦」到「SIA + CIF 双轨解耦」&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #555555;&quot;&gt;SIA 解决「尺度内全局建模」(窗口注意力),CIF 解决「跨尺度高效融合」(稀疏采样)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; color: #1f4e79;&quot;&gt;两者都用「高效」方式实现 → v4 在 COCO 上 55.3 AP (比 v3 +1.5 AP),小物体 +2.5 AP,保持 100+ FPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2.5;dashed=1;shadow=1;fontSize:12;fontColor=#666666;align=center;spacing=8;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="920" width="1820" height="80" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
